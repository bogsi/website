{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roussev-admin",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-11-01",

  // Only reachable through admin.roussev.dev, which Cloudflare Access guards.
  // A workers.dev or preview URL would bypass Access, so both are off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.roussev.dev", "custom_domain": true }],

  // The SPA is served as static assets: free, and does not count as a Worker
  // request. Only /api/* invokes the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roussev-orders",
      // Filled in by scripts/provision.ts in CI (written to wrangler.ci.jsonc).
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. The placeholder values are filled in by
  // scripts/provision.ts from the Cloudflare account during CI; locally,
  // override them in .dev.vars. RESEND_API_KEY is a secret, set by the script.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "FROM_EMAIL": "REPLACE_WITH_FROM_EMAIL",
    "ADMIN_EMAIL": "REPLACE_WITH_ADMIN_EMAIL"
  },

  // Retries queued emails that failed (Resend outage or daily quota).
  // The Free plan allows 5 cron triggers per account; this uses one.
  "triggers": { "crons": ["7 * * * *"] },

  "observability": { "enabled": true },

  // `wrangler dev` would otherwise rewrite requests to the custom domain's
  // host; keeping localhost lets ACCESS_DEV_EMAIL (.dev.vars) apply locally.
  "dev": { "host": "localhost", "port": 8787 }
}
